  "_locations_note": "A posting is alerted only if its location string lands in one of the buckets listed in keep_locations. Order matters: the first pattern that matches wins, so NY sits above Remote and 'Remote - New York' counts as NY. Drop a bucket from keep_locations to stop alerting on it without deleting its pattern.",
  "location_buckets": {
    "NY": "new york|nyc|\\bny\\b|brooklyn|manhattan",
    "London": "\\blondon\\b(?!,?\\s*(?:on|ont|ontario))|united kingdom|\\buk\\b|\\bengland\\b",
    "Paris": "\\bparis\\b(?!,?\\s*(?:tx|texas))|\\bfrance\\b",
